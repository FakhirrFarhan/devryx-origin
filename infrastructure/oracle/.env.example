# Copy to .env and chmod 600. Never commit secrets.
APP_ENV=production
PUBLIC_DOMAIN=example.com

# Neon PostgreSQL — backend only; never expose to browser/client code.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require

# Backend secrets: replace with long random values.
APP_SECRET_KEY=REPLACE_WITH_32_BYTE_OR_LONGER_RANDOM_SECRET
OTP_PEPPER=REPLACE_WITH_A_DIFFERENT_RANDOM_SECRET

# Email delivery provider credentials go here when OTP is implemented.
EMAIL_PROVIDER_API_KEY=
EMAIL_FROM=

# Object storage / Restic backup configuration is stored separately
# in a root-readable file outside this repository.
